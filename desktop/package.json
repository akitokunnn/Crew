{
  "name": "crew-desktop",
  "version": "0.3.18",
  "description": "Native Crew workspace launcher",
  "author": "Crew contributors",
  "license": "UNLICENSED",
  "private": true,
  "main": "src/main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --require ./test/fixtures/canonical-tmp.cjs --test test/*.test.cjs",
    "check:version": "node --test test/version-sync.test.cjs",
    "prebuild": "npm run check:version",
    "build": "node scripts/icon.cjs && electron-builder --win zip portable nsis --x64",
    "prebuild:dir": "npm run check:version",
    "build:dir": "node scripts/icon.cjs && electron-builder --win dir --x64",
    "prebuild:mac": "npm run check:version",
    "build:mac": "node scripts/icon.cjs && electron-builder --mac dmg zip --arm64"
  },
  "devDependencies": {
    "electron": "45.0.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "local.crew.desktop",
    "productName": "Crew",
    "asar": true,
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../plugin",
        "to": "backend",
        "filter": [
          "**/*",
          "!tests{,/**}",
          "!**/__pycache__/**",
          "!**/*.pyc",
          "!*-test-*/**"
        ]
      },
      {
        "from": "../frontend",
        "to": "frontend"
      }
    ],
    "win": {
      "artifactName": "Crew-${version}-win-${arch}.${ext}",
      "target": [
        "zip",
        "portable",
        "nsis"
      ],
      "icon": "assets/crew.ico",
      "signExecutable": false
    },
    "mac": {
      "artifactName": "Crew-${version}-mac-${arch}.${ext}",
      "target": [
        { "target": "dmg", "arch": ["arm64"] },
        { "target": "zip", "arch": ["arm64"] }
      ],
      "icon": "assets/crew-1024.png",
      "category": "public.app-category.developer-tools",
      "identity": "-",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "notarize": false
    },
    "dmg": {
      "artifactName": "Crew-${version}-mac-${arch}.dmg"
    },
    "portable": {
      "artifactName": "Crew-${version}-portable.exe"
    },
    "nsis": {
      "artifactName": "Crew-${version}-setup.exe",
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Crew",
      "uninstallDisplayName": "Crew",
      "deleteAppDataOnUninstall": false,
      "installerIcon": "assets/crew.ico",
      "uninstallerIcon": "assets/crew.ico",
      "installerHeaderIcon": "assets/crew.ico"
    }
  }
}
