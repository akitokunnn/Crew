{
  "name": "crew-desktop",
  "version": "0.3.1",
  "description": "Native Crew workspace launcher",
  "author": "Crew contributors",
  "license": "UNLICENSED",
  "private": true,
  "main": "src/main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.cjs",
    "check:version": "node --test test/version-sync.test.cjs",
    "prebuild": "npm run check:version",
    "build": "node scripts/icon.cjs && electron-builder --win zip portable nsis --x64",
    "prebuild:dir": "npm run check:version",
    "build:dir": "node scripts/icon.cjs && electron-builder --win dir --x64"
  },
  "devDependencies": {
    "electron": "45.0.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "local.crew.desktop.v2",
    "productName": "Crew V2",
    "asar": true,
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../plugin",
        "to": "backend",
        "filter": [
          "**/*",
          "!tests{,/**}",
          "!**/__pycache__/**",
          "!**/*.pyc",
          "!*-test-*/**"
        ]
      }
    ],
    "win": {
      "artifactName": "Crew-V2-${version}-win-${arch}.${ext}",
      "target": [
        "zip",
        "portable",
        "nsis"
      ],
      "icon": "assets/crew.ico",
      "signExecutable": false
    },
    "portable": {
      "artifactName": "Crew-V2-${version}-portable.exe"
    },
    "nsis": {
      "artifactName": "Crew-V2-${version}-setup.exe",
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Crew V2",
      "uninstallDisplayName": "Crew V2",
      "deleteAppDataOnUninstall": false,
      "installerIcon": "assets/crew.ico",
      "uninstallerIcon": "assets/crew.ico",
      "installerHeaderIcon": "assets/crew.ico"
    }
  }
}
